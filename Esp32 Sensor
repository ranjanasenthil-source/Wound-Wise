// ============================================================================
// WoundWise: Post-C-Section Early Warning System
// Microcontroller: ESP32 Dev Module
// Sensors: LM35D (GPIO 35), Resistive Moisture Probe AO (GPIO 34)
// Indicators: Green (GPIO 18), Yellow (GPIO 19), Red (GPIO 23), Buzzer (GPIO 5)
// Features: 10s Temperature Persistence Check + Firebase Cloud Sync
// ============================================================================

#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <HTTPClient.h>

// ----------------------------------------------------------------------------
// 1. Network & Cloud Configuration
// ----------------------------------------------------------------------------
const char* WIFI_SSID = "YOUR_HOTSPOT_NAME";       // Update with your hotspot/network SSID
const char* WIFI_PASS = "YOUR_HOTSPOT_PASSWORD";   // Update with your hotspot/network password

const char* FIREBASE_URL = "https://woundwise-iot-default-rtdb.firebaseio.com/telemetry.json";

// ----------------------------------------------------------------------------
// 2. Hardware Pin Definitions
// ----------------------------------------------------------------------------
const int PIN_LM35     = 35;  // LM35 Vout -> GPIO 35 (ADC1 Channel 7)
const int PIN_MOISTURE = 34;  // Moisture AO -> GPIO 34 (ADC1 Channel 6)

const int LED_GREEN    = 18;  // Normal recovery indicator
const int LED_YELLOW   = 19;  // Warning status indicator
const int LED_RED      = 23;  // Critical alert indicator
const int PIN_BUZZER   = 5;   // Active buzzer alert pin

// ----------------------------------------------------------------------------
// 3. Clinical Triage Thresholds & Timing Settings
// ----------------------------------------------------------------------------
const float TEMP_WARN = 37.5;  // Localized elevation (°C)
const float TEMP_CRIT = 38.3;  // Clinical fever escalation (°C)

// Inverted Moisture Calibration (Dry is high ~3500-4095; drops when wet)
const int MOISTURE_WET_WARN = 2500;  // Drops <= 2500 -> Warning
const int MOISTURE_SAT_CRIT = 1400;  // Drops <= 1400 -> Saturated / Critical

const int ADC_SAMPLES = 30;

// 10-Second Sustained Temperature Verification Settings
unsigned long tempCritStartTime = 0;
bool tempCritActive = false;
const unsigned long TEMP_CRIT_HOLD_TIME = 10000; // 10,000 ms = 10 seconds

enum TriageState {
  STATE_NORMAL,
  STATE_WARNING,
  STATE_CRITICAL
};

// ----------------------------------------------------------------------------
// 4. Helper Functions
// ----------------------------------------------------------------------------
void setAlertOutputs(bool green, bool yellow, bool red, bool buzzer) {
  digitalWrite(LED_GREEN, green ? HIGH : LOW);
  digitalWrite(LED_YELLOW, yellow ? HIGH : LOW);
  digitalWrite(LED_RED, red ? HIGH : LOW);
  digitalWrite(PIN_BUZZER, buzzer ? HIGH : LOW);
}

int readAveragedADC(int pin) {
  long sum = 0;
  for (int i = 0; i < ADC_SAMPLES; i++) {
    sum += analogRead(pin);
    delay(2);
  }
  return (int)(sum / ADC_SAMPLES);
}

float readLM35TempC() {
  long sumMV = 0;
  for (int i = 0; i < ADC_SAMPLES; i++) {
    sumMV += analogReadMilliVolts(PIN_LM35);
    delay(2);
  }
  float avgMV = (float)sumMV / ADC_SAMPLES;
  return avgMV / 10.0; // 10 mV = 1.0 °C
}

void pushTelemetryToFirebase(float tempC, int moistureADC, const char* statusStr) {
  if (WiFi.status() == WL_CONNECTED) {
    WiFiClientSecure client;
    client.setInsecure(); // Bypass SSL verification delays on demo networks

    HTTPClient http;
    http.begin(client, FIREBASE_URL);
    http.addHeader("Content-Type", "application/json");
    http.setTimeout(3000);

    String jsonPayload = "{";
    jsonPayload += "\"temperature\":" + String(tempC, 1) + ",";
    jsonPayload += "\"moisture\":" + String(moistureADC) + ",";
    jsonPayload += "\"status\":\"" + String(statusStr) + "\"";
    jsonPayload += "}";

    int httpResponseCode = http.PUT(jsonPayload);
    if (httpResponseCode > 0) {
      Serial.print(" | Cloud Sync: HTTP ");
      Serial.println(httpResponseCode);
    } else {
      Serial.print(" | Cloud Error: ");
      Serial.println(httpResponseCode);
    }
    http.end();
  } else {
    Serial.println(" | Wi-Fi Disconnected");
  }
}

// ----------------------------------------------------------------------------
// 5. Setup Routine
// ----------------------------------------------------------------------------
void setup() {
  Serial.begin(115200);

  pinMode(LED_GREEN, OUTPUT);
  pinMode(LED_YELLOW, OUTPUT);
  pinMode(LED_RED, OUTPUT);
  pinMode(PIN_BUZZER, OUTPUT);
  setAlertOutputs(false, false, false, false);

  analogReadResolution(12);
  analogSetPinAttenuation(PIN_LM35, ADC_11db);
  analogSetPinAttenuation(PIN_MOISTURE, ADC_11db);

  Serial.println("\n=========================================");
  Serial.println("WoundWise Diagnostic System Initializing...");
  Serial.println("=========================================");

  Serial.print("Connecting to Wi-Fi: ");
  Serial.println(WIFI_SSID);
  WiFi.begin(WIFI_SSID, WIFI_PASS);

  int retries = 0;
  while (WiFi.status() != WL_CONNECTED && retries < 20) {
    delay(500);
    Serial.print(".");
    retries++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWi-Fi Connected Successfully!");
    Serial.print("ESP32 IP Address: ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\nWi-Fi timeout. Continuing in local alert mode.");
  }
}

// ----------------------------------------------------------------------------
// 6. Main Execution Loop
// ----------------------------------------------------------------------------
void loop() {
  // 1. Read Averaged Sensor Telemetry
  float currentTemp = readLM35TempC();
  int rawMoisture = readAveragedADC(PIN_MOISTURE);
  unsigned long now = millis();

  // 2. Evaluate 10-Second Sustained Temperature Condition
  if (currentTemp >= TEMP_CRIT) {
    if (!tempCritActive) {
      tempCritStartTime = now;
      tempCritActive = true;
      Serial.println(">>> High Temperature Detected. Starting 10-second verification timer...");
    }
  } else {
    if (tempCritActive) {
      Serial.println(">>> Temperature dropped below 38.3°C. Resetting timer.");
    }
    tempCritActive = false;
    tempCritStartTime = 0;
  }

  bool isTempSustainedCritical = tempCritActive && ((now - tempCritStartTime) >= TEMP_CRIT_HOLD_TIME);

  // 3. Classify Clinical Triage Status
  TriageState currentState;
  const char* statusLabel;

  // SCENARIO 3: CRITICAL (Red LED + Active Buzzer)
  // Sustained high temp for >= 10 seconds OR immediate heavy moisture saturation
  if (isTempSustainedCritical || rawMoisture <= MOISTURE_SAT_CRIT) {
    currentState = STATE_CRITICAL;
    statusLabel = "CRITICAL";
  }
  // SCENARIO 2: WARNING (Yellow LED ON, Buzzer OFF)
  // Temp warming up (< 10s), mild elevation (>= 37.5°C), or early moisture
  else if (currentTemp >= TEMP_WARN || rawMoisture <= MOISTURE_WET_WARN) {
    currentState = STATE_WARNING;
    statusLabel = "WARNING";
  }
  // SCENARIO 1: NORMAL (Green LED ON, Buzzer OFF)
  else {
    currentState = STATE_NORMAL;
    statusLabel = "NORMAL";
  }

  // 4. Drive Physical Actuators
  switch (currentState) {
    case STATE_NORMAL:
      setAlertOutputs(true, false, false, false);
      break;
    case STATE_WARNING:
      setAlertOutputs(false, true, false, false);
      break;
    case STATE_CRITICAL:
      setAlertOutputs(false, false, true, true);
      break;
  }

  // 5. Output Local Serial Telemetry
  Serial.print("[STATUS: ");
  Serial.print(statusLabel);
  Serial.print("] Temp: ");
  Serial.print(currentTemp, 1);
  Serial.print(" °C | Moisture ADC: ");
  Serial.print(rawMoisture);

  if (tempCritActive && !isTempSustainedCritical) {
    unsigned long elapsed = (now - tempCritStartTime) / 1000;
    Serial.print(" | High-Temp Hold: ");
    Serial.print(elapsed);
    Serial.print("/10s");
  }

  // 6. Push Live State to Firebase Cloud Database
  pushTelemetryToFirebase(currentTemp, rawMoisture, statusLabel);

  delay(1000);
}